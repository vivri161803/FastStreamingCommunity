# Telegram API Credentials (obtain from https://my.telegram.org)
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Persistent session string (generated via 'npm run generate-session')
TG_SESSION=your_session_string_here

# Target Telegram channel: can be a numeric ID (e.g. -100123456789) or title/username
TG_CHANNEL=your_channel_id_or_title

# Optional: Default fallback URL if no redirect link is found in the channel
DEFAULT_FALLBACK_URL=https://google.com
