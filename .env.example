# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Numeric Telegram channel ID (starts with -100, e.g. -100123456789)
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx

# A secure random secret string to verify the webhook request is indeed from Telegram
TELEGRAM_WEBHOOK_SECRET=your_custom_webhook_secret_here

# Upstash Redis REST credentials (from your Upstash Console)
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Optional: Default fallback URL if no redirect link has been captured yet
DEFAULT_FALLBACK_URL=https://google.com
